{
  "info": {
    "name": "Carrito de Compras - QA Sprint 1",
    "description": "Coleccion de pruebas del microservicio de carrito (HU-01, HU-02, HU-03, RT-01). Ver docs/plan-pruebas.md. Requiere docker compose up --build. TC-22 y TC-23 (Redis) son manuales con redis-cli.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera tokens JWT (HS256) de prueba automaticamente. No hay que pegar tokens a mano.",
          "function b64url(wa) {",
          "  return CryptoJS.enc.Base64.stringify(wa).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "function makeToken(sub, secret) {",
          "  const header = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "  const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ sub: sub, exp: Math.floor(Date.now() / 1000) + 3600 })));",
          "  const sig = b64url(CryptoJS.HmacSHA256(header + '.' + payload, secret));",
          "  return header + '.' + payload + '.' + sig;",
          "}",
          "const cv = pm.collectionVariables;",
          "// Al iniciar la corrida (TC-01) se crean usuarios nuevos: asi la coleccion es repetible",
          "if (pm.info.requestName.indexOf('TC-01') === 0 || !cv.get('user1')) {",
          "  const run = Date.now();",
          "  cv.set('user1', 'qa_u1_' + run);",
          "  cv.set('user2', 'qa_u2_' + run);",
          "  cv.set('user3', 'qa_u3_' + run);",
          "}",
          "const secret = cv.get('jwtSecret');",
          "cv.set('token',  makeToken(cv.get('user1'), secret));",
          "cv.set('token2', makeToken(cv.get('user2'), secret));",
          "cv.set('token3', makeToken(cv.get('user3'), secret));"
        ]
      }
    }
  ],
